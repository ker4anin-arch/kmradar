[Unit]
Description=kmradar: сбор событий и утренний дайджест
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=kmradar
WorkingDirectory=/opt/kmradar
EnvironmentFile=/etc/kmradar.env
ExecStart=/usr/bin/python3 -m kmradar run --db /var/lib/kmradar/radar.db --source /var/lib/kmradar/data --telegram
