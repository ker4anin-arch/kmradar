[Unit]
Description=kmradar: веб-дайджест для КМ
After=network-online.target
Wants=network-online.target

[Service]
User=kmradar
WorkingDirectory=/opt/kmradar
EnvironmentFile=/etc/kmradar.env
Environment=TZ=Europe/Moscow
ExecStart=/usr/bin/python3 -m kmradar web --db /var/lib/kmradar/radar.db --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/kmradar
PrivateTmp=true

[Install]
WantedBy=multi-user.target
