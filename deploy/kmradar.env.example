# /etc/kmradar.env, права 600.
# Адрес сайта — для ссылок КМ
# RADAR_PORT установщик выберет сам (свободный, начиная с 8091)
BASE_URL=https://radar.example.ru
# Необязательно: Telegram (если нужен дубль в мессенджер)
TELEGRAM_TOKEN=
# HTTPS_PROXY=http://user:pass@host:port
# Появится, когда будет подключение к Checko
CHECKO_API_KEY=
# free — бесплатный ключ (100 запросов в день, экономный режим), paid — платный тариф
CHECKO_PLAN=free
